{
  "name": "nod-links",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "send_metrics": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nod-links",
      "database_id": "b687a3d4-5016-44fa-8ee1-74afcaa3a6fe",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://nod-archive.com"
  },
  "routes": [
    {
      "pattern": "nod-archive.com",
      "custom_domain": true
    }
  ]
}
