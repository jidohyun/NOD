{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nod.local/contracts/quality-receipt-v1.schema.json",
  "title": "NOD quality execution receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phase", "classification", "refs", "plan", "outcomes", "failures", "mutation", "result", "complete"],
  "properties": {
    "schema_version": {"const": 1},
    "phase": {"enum": ["pre-commit", "pre-push"]},
    "classification": {
      "enum": ["planned", "no_ref_updates", "malformed_input", "dirty_worktree", "stale_state", "history_base_unavailable", "unmapped_path", "tree_noop", "interrupted"]
    },
    "refs": {"type": "array", "items": {"$ref": "#/$defs/refOutcome"}},
    "plan": {"$ref": "#/$defs/labelPlan"},
    "outcomes": {"$ref": "#/$defs/outcomes"},
    "failures": {"type": "array", "items": {"$ref": "#/$defs/failure"}},
    "mutation": {"$ref": "#/$defs/mutation"},
    "result": {"enum": ["pass", "failed", "not_run"]},
    "complete": {"type": "boolean"}
  },
  "$defs": {
    "oid": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "label": {
      "enum": ["contract_validation", "api_lint", "api_test", "worker_lint", "worker_test", "web_lint", "web_test", "mobile_lint", "mobile_test", "dockerfile_lint", "secret_scan", "handoff", "generated_drift", "mutation_check"]
    },
    "labels": {"type": "array", "items": {"$ref": "#/$defs/label"}, "uniqueItems": true},
    "refOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote_ref", "remote_oid", "status"],
      "properties": {
        "remote_ref": {"type": "string", "minLength": 1},
        "remote_oid": {"$ref": "#/$defs/oid"},
        "status": {"enum": ["pass", "failed", "skipped", "not_run"]}
      }
    },
    "labelPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "skipped"],
      "properties": {"selected": {"$ref": "#/$defs/labels"}, "skipped": {"$ref": "#/$defs/labels"}},
      "allOf": [
        {"if": {"properties": {"selected": {"contains": {"const": "contract_validation"}}}}, "then": {"properties": {"skipped": {"not": {"contains": {"const": "contract_validation"}}}}}},
        {"if": {"properties": {"selected": {"contains": {"const": "api_lint"}}}}, "then": {"properties": {"skipped": {"not": {"contains": {"const": "api_lint"}}}}}},
        {"if": {"properties": {"selected": {"contains": {"const": "api_test"}}}}, "then": {"properties": {"skipped": {"not": {"contains": {"const": "api_test"}}}}}},
        {"if": {"properties": {"selected": {"contains": {"const": "worker_lint"}}}}, "then": {"properties": {"skipped": {"not": {"contains": {"const": "worker_lint"}}}}}},
        {"if": {"properties": {"selected": {"contains": {"const": "worker_test"}}}}, "then": {"properties": {"skipped": {"not": {"contains": {"const": "worker_test"}}}}}},
        {"if": {"properties": {"selected": {"contains": {"const": "web_lint"}}}}, "then": {"properties": {"skipped": {"not": {"contains": {"const": "web_lint"}}}}}},
        {"if": {"properties": {"selected": {"contains": {"const": "web_test"}}}}, "then": {"properties": {"skipped": {"not": {"contains": {"const": "web_test"}}}}}},
        {"if": {"properties": {"selected": {"contains": {"const": "mobile_lint"}}}}, "then": {"properties": {"skipped": {"not": {"contains": {"const": "mobile_lint"}}}}}},
        {"if": {"properties": {"selected": {"contains": {"const": "mobile_test"}}}}, "then": {"properties": {"skipped": {"not": {"contains": {"const": "mobile_test"}}}}}},
        {"if": {"properties": {"selected": {"contains": {"const": "dockerfile_lint"}}}}, "then": {"properties": {"skipped": {"not": {"contains": {"const": "dockerfile_lint"}}}}}},
        {"if": {"properties": {"selected": {"contains": {"const": "secret_scan"}}}}, "then": {"properties": {"skipped": {"not": {"contains": {"const": "secret_scan"}}}}}},
        {"if": {"properties": {"selected": {"contains": {"const": "handoff"}}}}, "then": {"properties": {"skipped": {"not": {"contains": {"const": "handoff"}}}}}},
        {"if": {"properties": {"selected": {"contains": {"const": "generated_drift"}}}}, "then": {"properties": {"skipped": {"not": {"contains": {"const": "generated_drift"}}}}}},
        {"if": {"properties": {"selected": {"contains": {"const": "mutation_check"}}}}, "then": {"properties": {"skipped": {"not": {"contains": {"const": "mutation_check"}}}}}}
      ]
    },
    "outcomes": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/label"},
      "additionalProperties": {"$ref": "#/$defs/outcome"}
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "exit_code"],
      "properties": {
        "status": {"enum": ["pass", "failed", "skipped", "not_run"]},
        "exit_code": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "pass"}}}, "then": {"properties": {"exit_code": {"const": 0}}}},
        {"if": {"properties": {"status": {"const": "failed"}}}, "then": {"properties": {"exit_code": {"minimum": 1}}}}
      ]
    },
    "nonFailedOutcome": {
      "not": {"type": "object", "required": ["status"], "properties": {"status": {"const": "failed"}}}
    },
    "failedOutcome": {
      "type": "object",
      "required": ["status", "exit_code"],
      "properties": {"status": {"const": "failed"}, "exit_code": {"minimum": 1}}
    },
    "selectedOutcome": {
      "not": {"type": "object", "required": ["status"], "properties": {"status": {"const": "skipped"}}}
    },
    "skippedOutcome": {
      "type": "object",
      "required": ["status", "exit_code"],
      "properties": {"status": {"const": "skipped"}, "exit_code": {"const": 0}}
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {"enum": ["COMMAND_FAILED", "MUTATION_DETECTED", "RECEIPT_WRITE_FAILED", "INTERRUPTED", "MALFORMED_INPUT", "DIRTY_WORKTREE", "STALE_STATE"]},
        "gate": {"$ref": "#/$defs/label"}
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "after": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"classification": {"enum": ["malformed_input", "dirty_worktree", "stale_state"]}}}, "then": {"properties": {"result": {"const": "failed"}}}},
    {"if": {"properties": {"plan": {"properties": {"selected": {"contains": {"const": "contract_validation"}}}}}}, "then": {"properties": {"outcomes": {"required": ["contract_validation"], "properties": {"contract_validation": {"$ref": "#/$defs/selectedOutcome"}}}}}, "else": {"if": {"properties": {"plan": {"properties": {"skipped": {"contains": {"const": "contract_validation"}}}}}}, "then": {"properties": {"outcomes": {"required": ["contract_validation"], "properties": {"contract_validation": {"$ref": "#/$defs/skippedOutcome"}}}}}, "else": {"properties": {"outcomes": {"not": {"required": ["contract_validation"]}}}}}},
    {"if": {"properties": {"plan": {"properties": {"selected": {"contains": {"const": "api_lint"}}}}}}, "then": {"properties": {"outcomes": {"required": ["api_lint"], "properties": {"api_lint": {"$ref": "#/$defs/selectedOutcome"}}}}}, "else": {"if": {"properties": {"plan": {"properties": {"skipped": {"contains": {"const": "api_lint"}}}}}}, "then": {"properties": {"outcomes": {"required": ["api_lint"], "properties": {"api_lint": {"$ref": "#/$defs/skippedOutcome"}}}}}, "else": {"properties": {"outcomes": {"not": {"required": ["api_lint"]}}}}}},
    {"if": {"properties": {"plan": {"properties": {"selected": {"contains": {"const": "api_test"}}}}}}, "then": {"properties": {"outcomes": {"required": ["api_test"], "properties": {"api_test": {"$ref": "#/$defs/selectedOutcome"}}}}}, "else": {"if": {"properties": {"plan": {"properties": {"skipped": {"contains": {"const": "api_test"}}}}}}, "then": {"properties": {"outcomes": {"required": ["api_test"], "properties": {"api_test": {"$ref": "#/$defs/skippedOutcome"}}}}}, "else": {"properties": {"outcomes": {"not": {"required": ["api_test"]}}}}}},
    {"if": {"properties": {"plan": {"properties": {"selected": {"contains": {"const": "worker_lint"}}}}}}, "then": {"properties": {"outcomes": {"required": ["worker_lint"], "properties": {"worker_lint": {"$ref": "#/$defs/selectedOutcome"}}}}}, "else": {"if": {"properties": {"plan": {"properties": {"skipped": {"contains": {"const": "worker_lint"}}}}}}, "then": {"properties": {"outcomes": {"required": ["worker_lint"], "properties": {"worker_lint": {"$ref": "#/$defs/skippedOutcome"}}}}}, "else": {"properties": {"outcomes": {"not": {"required": ["worker_lint"]}}}}}},
    {"if": {"properties": {"plan": {"properties": {"selected": {"contains": {"const": "worker_test"}}}}}}, "then": {"properties": {"outcomes": {"required": ["worker_test"], "properties": {"worker_test": {"$ref": "#/$defs/selectedOutcome"}}}}}, "else": {"if": {"properties": {"plan": {"properties": {"skipped": {"contains": {"const": "worker_test"}}}}}}, "then": {"properties": {"outcomes": {"required": ["worker_test"], "properties": {"worker_test": {"$ref": "#/$defs/skippedOutcome"}}}}}, "else": {"properties": {"outcomes": {"not": {"required": ["worker_test"]}}}}}},
    {"if": {"properties": {"plan": {"properties": {"selected": {"contains": {"const": "web_lint"}}}}}}, "then": {"properties": {"outcomes": {"required": ["web_lint"], "properties": {"web_lint": {"$ref": "#/$defs/selectedOutcome"}}}}}, "else": {"if": {"properties": {"plan": {"properties": {"skipped": {"contains": {"const": "web_lint"}}}}}}, "then": {"properties": {"outcomes": {"required": ["web_lint"], "properties": {"web_lint": {"$ref": "#/$defs/skippedOutcome"}}}}}, "else": {"properties": {"outcomes": {"not": {"required": ["web_lint"]}}}}}},
    {"if": {"properties": {"plan": {"properties": {"selected": {"contains": {"const": "web_test"}}}}}}, "then": {"properties": {"outcomes": {"required": ["web_test"], "properties": {"web_test": {"$ref": "#/$defs/selectedOutcome"}}}}}, "else": {"if": {"properties": {"plan": {"properties": {"skipped": {"contains": {"const": "web_test"}}}}}}, "then": {"properties": {"outcomes": {"required": ["web_test"], "properties": {"web_test": {"$ref": "#/$defs/skippedOutcome"}}}}}, "else": {"properties": {"outcomes": {"not": {"required": ["web_test"]}}}}}},
    {"if": {"properties": {"plan": {"properties": {"selected": {"contains": {"const": "mobile_lint"}}}}}}, "then": {"properties": {"outcomes": {"required": ["mobile_lint"], "properties": {"mobile_lint": {"$ref": "#/$defs/selectedOutcome"}}}}}, "else": {"if": {"properties": {"plan": {"properties": {"skipped": {"contains": {"const": "mobile_lint"}}}}}}, "then": {"properties": {"outcomes": {"required": ["mobile_lint"], "properties": {"mobile_lint": {"$ref": "#/$defs/skippedOutcome"}}}}}, "else": {"properties": {"outcomes": {"not": {"required": ["mobile_lint"]}}}}}},
    {"if": {"properties": {"plan": {"properties": {"selected": {"contains": {"const": "mobile_test"}}}}}}, "then": {"properties": {"outcomes": {"required": ["mobile_test"], "properties": {"mobile_test": {"$ref": "#/$defs/selectedOutcome"}}}}}, "else": {"if": {"properties": {"plan": {"properties": {"skipped": {"contains": {"const": "mobile_test"}}}}}}, "then": {"properties": {"outcomes": {"required": ["mobile_test"], "properties": {"mobile_test": {"$ref": "#/$defs/skippedOutcome"}}}}}, "else": {"properties": {"outcomes": {"not": {"required": ["mobile_test"]}}}}}},
    {"if": {"properties": {"plan": {"properties": {"selected": {"contains": {"const": "dockerfile_lint"}}}}}}, "then": {"properties": {"outcomes": {"required": ["dockerfile_lint"], "properties": {"dockerfile_lint": {"$ref": "#/$defs/selectedOutcome"}}}}}, "else": {"if": {"properties": {"plan": {"properties": {"skipped": {"contains": {"const": "dockerfile_lint"}}}}}}, "then": {"properties": {"outcomes": {"required": ["dockerfile_lint"], "properties": {"dockerfile_lint": {"$ref": "#/$defs/skippedOutcome"}}}}}, "else": {"properties": {"outcomes": {"not": {"required": ["dockerfile_lint"]}}}}}},
    {"if": {"properties": {"plan": {"properties": {"selected": {"contains": {"const": "secret_scan"}}}}}}, "then": {"properties": {"outcomes": {"required": ["secret_scan"], "properties": {"secret_scan": {"$ref": "#/$defs/selectedOutcome"}}}}}, "else": {"if": {"properties": {"plan": {"properties": {"skipped": {"contains": {"const": "secret_scan"}}}}}}, "then": {"properties": {"outcomes": {"required": ["secret_scan"], "properties": {"secret_scan": {"$ref": "#/$defs/skippedOutcome"}}}}}, "else": {"properties": {"outcomes": {"not": {"required": ["secret_scan"]}}}}}},
    {"if": {"properties": {"plan": {"properties": {"selected": {"contains": {"const": "handoff"}}}}}}, "then": {"properties": {"outcomes": {"required": ["handoff"], "properties": {"handoff": {"$ref": "#/$defs/selectedOutcome"}}}}}, "else": {"if": {"properties": {"plan": {"properties": {"skipped": {"contains": {"const": "handoff"}}}}}}, "then": {"properties": {"outcomes": {"required": ["handoff"], "properties": {"handoff": {"$ref": "#/$defs/skippedOutcome"}}}}}, "else": {"properties": {"outcomes": {"not": {"required": ["handoff"]}}}}}},
    {"if": {"properties": {"plan": {"properties": {"selected": {"contains": {"const": "generated_drift"}}}}}}, "then": {"properties": {"outcomes": {"required": ["generated_drift"], "properties": {"generated_drift": {"$ref": "#/$defs/selectedOutcome"}}}}}, "else": {"if": {"properties": {"plan": {"properties": {"skipped": {"contains": {"const": "generated_drift"}}}}}}, "then": {"properties": {"outcomes": {"required": ["generated_drift"], "properties": {"generated_drift": {"$ref": "#/$defs/skippedOutcome"}}}}}, "else": {"properties": {"outcomes": {"not": {"required": ["generated_drift"]}}}}}},
    {"if": {"properties": {"plan": {"properties": {"selected": {"contains": {"const": "mutation_check"}}}}}}, "then": {"properties": {"outcomes": {"required": ["mutation_check"], "properties": {"mutation_check": {"$ref": "#/$defs/selectedOutcome"}}}}}, "else": {"if": {"properties": {"plan": {"properties": {"skipped": {"contains": {"const": "mutation_check"}}}}}}, "then": {"properties": {"outcomes": {"required": ["mutation_check"], "properties": {"mutation_check": {"$ref": "#/$defs/skippedOutcome"}}}}}, "else": {"properties": {"outcomes": {"not": {"required": ["mutation_check"]}}}}}},
    {"if": {"properties": {"result": {"const": "pass"}}}, "then": {"properties": {"failures": {"maxItems": 0}, "outcomes": {"additionalProperties": {"$ref": "#/$defs/nonFailedOutcome"}}, "refs": {"not": {"contains": {"type": "object", "required": ["status"], "properties": {"status": {"const": "failed"}}}}}, "complete": {"const": true}}}},
    {"if": {"properties": {"result": {"const": "failed"}}}, "then": {"properties": {"failures": {"minItems": 1}, "outcomes": {"anyOf": [
      {"required": ["contract_validation"], "properties": {"contract_validation": {"$ref": "#/$defs/failedOutcome"}}},
      {"required": ["api_lint"], "properties": {"api_lint": {"$ref": "#/$defs/failedOutcome"}}},
      {"required": ["api_test"], "properties": {"api_test": {"$ref": "#/$defs/failedOutcome"}}},
      {"required": ["worker_lint"], "properties": {"worker_lint": {"$ref": "#/$defs/failedOutcome"}}},
      {"required": ["worker_test"], "properties": {"worker_test": {"$ref": "#/$defs/failedOutcome"}}},
      {"required": ["web_lint"], "properties": {"web_lint": {"$ref": "#/$defs/failedOutcome"}}},
      {"required": ["web_test"], "properties": {"web_test": {"$ref": "#/$defs/failedOutcome"}}},
      {"required": ["mobile_lint"], "properties": {"mobile_lint": {"$ref": "#/$defs/failedOutcome"}}},
      {"required": ["mobile_test"], "properties": {"mobile_test": {"$ref": "#/$defs/failedOutcome"}}},
      {"required": ["dockerfile_lint"], "properties": {"dockerfile_lint": {"$ref": "#/$defs/failedOutcome"}}},
      {"required": ["secret_scan"], "properties": {"secret_scan": {"$ref": "#/$defs/failedOutcome"}}},
      {"required": ["handoff"], "properties": {"handoff": {"$ref": "#/$defs/failedOutcome"}}},
      {"required": ["generated_drift"], "properties": {"generated_drift": {"$ref": "#/$defs/failedOutcome"}}},
      {"required": ["mutation_check"], "properties": {"mutation_check": {"$ref": "#/$defs/failedOutcome"}}}
    ]}}}}
  ]
}
